rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isApprovedEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['thisispoovu03@gmail.com', 'shivadharshinid13@gmail.com'];
    }
    function member(coupleId) {
      return coupleId == 'our-little-universe' && signedIn()
        && isApprovedEmail();
    }

    match /couples/{coupleId}/media/{uid}/{fileId} {
      allow read: if member(coupleId);
      allow create, update: if member(coupleId)
        && (uid == request.auth.uid || uid == request.auth.token.email.lower())
        && request.resource.size <= 2 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif|heic|heif)|video/(mp4|webm|quicktime)|audio/(webm|mpeg|mp4|ogg|wav)');
      allow delete: if member(coupleId)
        && (uid == request.auth.uid || uid == request.auth.token.email.lower());
    }

    match /couples/{coupleId}/profiles/{uid}/{fileName} {
      allow read: if member(coupleId);
      allow create, update: if member(coupleId)
        && (uid == request.auth.uid || uid == request.auth.token.email.lower())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if member(coupleId)
        && (uid == request.auth.uid || uid == request.auth.token.email.lower());
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
